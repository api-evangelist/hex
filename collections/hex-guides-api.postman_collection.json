          "request": {
            "name": "Upsert Guide Draft",
            "description": {
              "content": "Update or create guide drafts by filePath.\n\nAccepts a dictionary mapping file paths to their contents.\nFor each file:\n- If the guide doesn't exist, it will be created.\n- If the guide exists but has no draft, a new draft will be created.\n- If the guide exists with a draft, the draft contents will be updated.",
              "type": "text/plain"
            },
