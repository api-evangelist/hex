{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hex Cells Context API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Context",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ListTopics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hex.tech/api/v1/context/topics",
            "params": [
              {
                "name": "after",
                "value": "",
                "type": "query"
              },
              {
                "name": "before",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List thread topics in the workspace, sorted by name.\n\nThis endpoint is subject to the following rate limits:\n- `hex-api`: Default rate limit group for the Hex API\n  - Max requests per minute may vary (default: 30)\n  - Max requests per hour may vary (default: 1800)"
        }
      ]
    }
  ],
  "bundled": true
}