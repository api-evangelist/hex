{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hex Cells Collections API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Collections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GetCollection",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hex.tech/api/v1/collections/:collectionId",
            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path"
              }
            ]
          }
        },
        {
          "info": {
            "name": "EditCollection",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.hex.tech/api/v1/collections/:collectionId",
            "params": [
              {
                "name": "collectionId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        },
        {
          "info": {
            "name": "ListCollections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hex.tech/api/v1/collections",
            "params": [
              {
                "name": "after",
                "value": "",
                "type": "query"
              },
              {
                "name": "before",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "sortBy",
                "value": "",
                "type": "query"
              }
            ]
          }
        },
        {
          "info": {
            "name": "CreateCollection",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hex.tech/api/v1/collections",
            "body": {
              "type": "json",
              "data": "{}"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}